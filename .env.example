# ------------------------------------------------------------------------------
# JurayKV Production Environment Configuration (.env)
# Rename this file to .env and fill in your actual production credentials.
# On first deploy, this will be pushed to the Hostinger VPS from GitHub Secrets (APP_ENV).
# ------------------------------------------------------------------------------

# Application Ports (automatically discovered and assigned if empty or conflict)
UI_PORT=5000
API_PORT=5001
ASPNETCORE_ENVIRONMENT=Production

# Database Connection
ConnectionStrings__DefaultConnection=Server=147.93.128.160,1433;Database=db_a64c98_kview;User Id=user_db;Password=YourPasswordHere;TrustServerCertificate=True;

# Payment Gateways - Flutterwave / Rave
RaveConfig__IsLive=false
RaveConfig__PbfPubKey=FLWPUBK_TEST-xxxxxxxxxxxx
RaveConfig__SecretKey=FLWSECK_TEST-xxxxxxxxxxxx
FLWSECK-Key=FLWSECK-xxxxxxxxxxxx
FLWSECK_Key=FLWSECK-xxxxxxxxxxxx

# Email - Postmark
PostmarkSettings__ServerToken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Payment Gateways - Interswitch
Interswitch__ClientId=IKIAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Interswitch__ClientSecret=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
Interswitch__MerchantCode=VNA

# Payment Gateways - Opay
OpayInit__BaseUrl=https://testapi.opaycheckout.com
OpayInit__MarchantId=256623121083870
OpayInit__PublicKey=OPAYPUBxxxxxxxxxxxx
OpayInit__PrivateKey=OPAYPRVxxxxxxxxxxxx

# VTU Service
VTU__BaseUrl=https://vtu.ng/wp-json/api/v1/
VTU__Username=XYZTECH
VTU__SecretKey=YourVtuSecretHere

# SMS Service
SmsApiToken=YourSmsApiTokenHere

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 / Cloud Storage
AwsConfiguration__AWSAccessKey=AKIAxxxxxxxxxxxxxxxx
AwsConfiguration__AWSSecretKey=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Authentication (for JurayKV.Api)
Jwt__Key=YourBase64OrLongSecretJwtKeyHere=======================
Jwt__Issuer=SampleIdentity.com
Jwt__LifeTime=86400

# External Login Providers (OAuth)
ExternalLoginProviders__Google__ClientId=xxxxxxxx.apps.googleusercontent.com
ExternalLoginProviders__Google__ClientSecret=xxxxxxxx
ExternalLoginProviders__Facebook__AppId=xxxxxxxx
ExternalLoginProviders__Facebook__AppSecret=xxxxxxxx
ExternalLoginProviders__Twitter__ConsumerKey=xxxxxxxx
ExternalLoginProviders__Twitter__ConsumerSecret=xxxxxxxx
ExternalLoginProviders__Microsoft__ApplicationId=xxxxxxxx
ExternalLoginProviders__Microsoft__Password=xxxxxxxx
